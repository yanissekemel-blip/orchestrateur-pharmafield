{
  "$schema": "https://turborepo.com/schema.json",
  "globalEnv": [
    "WEB_URL",
    "API_URL",
    "VITE_API_URL",
    "WEB_DEV_PORT",
    "API_DEV_PORT",
    "PORT",
    "CADDY_HTTP_PORT",
    "DATABASE_URL",
    "BETTER_AUTH_SECRET"
  ],
  "tasks": {
    "dev": { "cache": false, "persistent": true },
    "dev:worker": { "cache": false, "persistent": true },
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**"] },
    "typecheck": { "dependsOn": ["^typecheck"] },
    "test": { "dependsOn": ["^test"] }
  }
}
