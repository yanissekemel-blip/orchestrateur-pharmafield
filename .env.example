# Via Caddy (default): http://orchestrateur-pharmafield.localhost and
# http://api.orchestrateur-pharmafield.localhost. make up picks an initial web
# port in .env.local; bun run dev selects free ports in ignored .env.ports and
# updates Caddy after both servers start. Without Caddy, set the three public
# URLs below to the direct server origins yourself.
WEB_URL=http://orchestrateur-pharmafield.localhost
API_URL=http://api.orchestrateur-pharmafield.localhost
VITE_API_URL=http://api.orchestrateur-pharmafield.localhost
# MapLibre style URL for maps. Empty: OpenFreeMap's free OpenStreetMap style.
VITE_MAP_STYLE_URL=
# Host port Caddy listens on. Keep 80 for port-less .localhost URLs; when you
# change it, add the port to the three URLs above.
CADDY_HTTP_PORT=80
# make up saves the initial web port to .env.local; active ports use .env.ports.
WEB_DEV_PORT=0
API_DEV_PORT=
PORT=3000
DATABASE_URL=postgres://pharmafield:pharmafield@localhost:55434/pharmafield
BETTER_AUTH_SECRET=replace-this-with-a-random-secret-at-least-32-characters
# The API sends mail to the local Mailpit SMTP server. Inbox: http://localhost:8027
SMTP_HOST=127.0.0.1
SMTP_PORT=1027
SMTP_FROM=no-reply@orchestrateur-pharmafield.localhost
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
LOG_LEVEL=info
